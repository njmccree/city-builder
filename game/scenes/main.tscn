[sub_resource type="Shader" id="Shader_ground"]
code = "shader_type spatial;

// Temporary test ground: a 10 m minor grid and a 100 m major grid, drawn from world position so it
// needs no texture. Replaced when real terrain exists.
varying vec3 world_pos;

float grid_line(vec2 p, float cell) {
	vec2 q = p / cell;
	vec2 g = abs(fract(q - 0.5) - 0.5) / max(fwidth(q), vec2(0.0001));
	return 1.0 - min(min(g.x, g.y), 1.0);
}

void vertex() {
	world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	vec2 p = world_pos.xz;
	vec3 color = vec3(0.30, 0.45, 0.27);
	color = mix(color, vec3(0.16, 0.27, 0.15), grid_line(p, 10.0) * 0.55);
	color = mix(color, vec3(0.92, 0.9, 0.78), grid_line(p, 100.0) * 0.6);
	ALBEDO = color;
	ROUGHNESS = 1.0;
}
"

