# Build outputs
build/
out/
CMakeUserPresets.json

# Godot
game/.godot/
# Built extension libraries; the .gdextension descriptor next to them is source.
game/bin/*
!game/bin/citysim.gdextension
!game/bin/citysim.gdextension.uid
*.import

# IDEs (keep the recommended-extensions list)
.vs/
.vscode/*
!.vscode/extensions.json
.idea/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Test-generated save files (fixtures are allowed)
*.csav
!sim/tests/fixtures/**/*.csav

# Generated map packages (architecture §15.2); the pipeline rebuilds them. Each maps/ folder keeps its README.md.
game/content/**/maps/*/

# Python (tools/terrain)
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/
venv/

# Local dependency downloads (cmake -DFETCHCONTENT_BASE_DIR=.fetchcontent, as CI does)
.fetchcontent/
