# CTest driver for citysim_headless. Inputs: HEADLESS (path to the tool), MODE, WORKDIR.

function(run_headless output_var)
    execute_process(COMMAND ${HEADLESS} ${ARGN}
        OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE code)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "citysim_headless ${ARGN} exited with ${code}: ${err}")
    endif()
    set(${output_var} "${out}" PARENT_SCOPE)
endfunction()

function(final_line output_var text)
    string(REGEX MATCH "final [0-9]+ [0-9a-f]+" line "${text}")
    set(${output_var} "${line}" PARENT_SCOPE)
endfunction()

if(MODE STREQUAL "determinism")
    run_headless(first --seed 42 --ticks 500)
    run_headless(second --seed 42 --ticks 500)
    if(NOT first STREQUAL second)
        message(FATAL_ERROR "two runs with the same seed printed different output:\n${first}\n---\n${second}")
    endif()
    final_line(line "${first}")
    if(NOT line)
        message(FATAL_ERROR "no 'final' line in the output:\n${first}")
    endif()

    # The thread count must never change the result.
    run_headless(one_thread --seed 42 --ticks 500 --threads 1)
    run_headless(eight_threads --seed 42 --ticks 500 --threads 8)
    if(NOT one_thread STREQUAL eight_threads OR NOT one_thread STREQUAL first)
        message(FATAL_ERROR "output depends on the thread count:\n${one_thread}\n---\n${eight_threads}\n---\n${first}")
    endif()

    run_headless(other --seed 43 --ticks 500)
    if(first STREQUAL other)
        message(FATAL_ERROR "different seeds printed identical output")
    endif()
elseif(MODE STREQUAL "replay")
    set(log_file "${WORKDIR}/recorded_input_log.txt")
    file(REMOVE "${log_file}")
    run_headless(recorded --seed 42 --ticks 500 --record-log "${log_file}")
    final_line(recorded_final "${recorded}")

    file(READ "${log_file}" log_text)
    if(NOT log_text MATCHES "DebugSetComponentValue")
        message(FATAL_ERROR "the recorded log has no commands in it:\n${log_text}")
    endif()

    run_headless(replayed --replay "${log_file}")
    final_line(replayed_final "${replayed}")
    if(NOT recorded_final STREQUAL replayed_final OR NOT recorded_final)
        message(FATAL_ERROR "replay differs from the recording: '${recorded_final}' vs '${replayed_final}'")
    endif()
    if(NOT recorded STREQUAL replayed)
        message(FATAL_ERROR "replay printed different hashes along the way:\n${recorded}\n---\n${replayed}")
    endif()

    # Replay must really depend on the log: logs that differ in one command value must end differently.
    # (Small hand-written logs, because in a long log a later command can overwrite an earlier change.)
    set(header "citysim-input-log 1\nseed 42\nticks 60\n")
    file(WRITE "${WORKDIR}/log_a.txt" "${header}25 1 DebugSetComponentValue 12 5\n")
    file(WRITE "${WORKDIR}/log_b.txt" "${header}25 1 DebugSetComponentValue 12 6\n")
    file(WRITE "${WORKDIR}/log_none.txt" "${header}")
    run_headless(out_a --replay "${WORKDIR}/log_a.txt")
    run_headless(out_b --replay "${WORKDIR}/log_b.txt")
    run_headless(out_none --replay "${WORKDIR}/log_none.txt")
    final_line(final_a "${out_a}")
    final_line(final_b "${out_b}")
    final_line(final_none "${out_none}")
    if(final_a STREQUAL final_b OR final_a STREQUAL final_none OR final_b STREQUAL final_none)
        message(FATAL_ERROR "replay ignored the log contents: '${final_a}' '${final_b}' '${final_none}'")
    endif()
else()
    message(FATAL_ERROR "unknown MODE '${MODE}'")
endif()
